<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/match_obsidian"
    android:paddingTop="@dimen/spacing_xxxl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile"
            android:textSize="@dimen/text_title"
            android:textColor="@color/match_text_primary"
            android:fontFamily="sans-serif-light"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_xl" />

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_premium"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/spacing_xl"
            android:layout_marginHorizontal="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_xl">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivAvatar"
                android:layout_width="@dimen/avatar_large"
                android:layout_height="@dimen/avatar_large"
                android:src="@drawable/bg_placeholder"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/match_gold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_subtitle"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="user@email.com"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="@dimen/spacing_xxs" />

                <TextView
                    android:id="@+id/tvEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_profile"
                    android:textColor="@color/match_gold"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="@dimen/spacing_sm" />
            </LinearLayout>
        </LinearLayout>

        <!-- Membership -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_premium"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/spacing_xl"
            android:layout_marginHorizontal="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_xl">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_star"
                android:contentDescription="Membership"
                app:tint="@color/match_gold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/membership_premium"
                    android:textColor="@color/match_gold"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/membership_desc"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Open"
                app:tint="@color/match_text_hint" />
        </LinearLayout>

        <!-- General Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/general"
            style="@style/TextAppearance.Modela.Label"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_md" />

        <LinearLayout
            android:id="@+id/itemNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingVertical="@dimen/spacing_lg">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_notification" app:tint="@color/match_text_secondary" android:contentDescription="Notifications" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/notifications" android:textColor="@color/match_text_primary" android:textSize="@dimen/text_body" android:layout_marginStart="@dimen/spacing_lg" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/match_text_hint" android:contentDescription="Open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingVertical="@dimen/spacing_lg">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lock" app:tint="@color/match_text_secondary" android:contentDescription="Privacy" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/privacy" android:textColor="@color/match_text_primary" android:textSize="@dimen/text_body" android:layout_marginStart="@dimen/spacing_lg" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/match_text_hint" android:contentDescription="Open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingVertical="@dimen/spacing_lg">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_settings" app:tint="@color/match_text_secondary" android:contentDescription="Help" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/help_support" android:textColor="@color/match_text_primary" android:textSize="@dimen/text_body" android:layout_marginStart="@dimen/spacing_lg" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/match_text_hint" android:contentDescription="Open" />
        </LinearLayout>

        <!-- Logout -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logout"
            android:layout_marginHorizontal="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:layout_marginBottom="@dimen/spacing_xxl"
            style="@style/Widget.Modela.Button.Outlined" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version"
            android:textColor="@color/match_text_hint"
            android:textSize="@dimen/text_small"
            android:gravity="center"
            android:paddingBottom="@dimen/spacing_xxl" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
