<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_premium"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:layout_marginBottom="@dimen/spacing_md">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivReviewerAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_avatar_placeholder"
            app:civ_border_width="1dp"
            app:civ_border_color="@color/match_card_border" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_md">
            <TextView
                android:id="@+id/tvReviewerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/match_text_primary"
                android:textSize="@dimen/text_caption"
                android:fontFamily="@font/montserrat_variablefont_wght"
                android:textFontWeight="700"/>
            <LinearLayout
                android:id="@+id/starsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_xxs" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/tvReviewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/match_text_secondary"
        android:textSize="@dimen/text_caption"
        android:fontFamily="@font/montserrat_variablefont_wght"
        android:textFontWeight="600"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="@dimen/spacing_md" />
</LinearLayout>
