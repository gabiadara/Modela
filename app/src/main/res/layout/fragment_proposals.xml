<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/match_obsidian">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_lg">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Propostas"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_headline"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvProposalCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/match_text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_lg">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/category_chip_height"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_category_chip"
                android:text="Todas"
                android:textColor="@color/match_text_primary"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/chipPending"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/category_chip_height"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_category_chip"
                android:text="Pendentes"
                android:textColor="@color/match_text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/chipAccepted"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/category_chip_height"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_category_chip"
                android:text="Aceitas"
                android:textColor="@color/match_text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/chipCompleted"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/category_chip_height"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="@drawable/bg_category_chip"
                android:text="Concluídas"
                android:textColor="@color/match_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Company-only: Create Proposal Button -->
    <TextView
        android:id="@+id/btnCreateProposal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:background="@drawable/bg_button_gold"
        android:gravity="center"
        android:text="＋  Nova Proposta"
        android:textColor="@color/match_white"
        android:textSize="@dimen/text_button"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_xxxl"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_proposals"
            android:alpha="0.3"
            app:tint="@color/match_text_secondary"
            android:contentDescription="Sem propostas" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nenhuma proposta ainda"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_subtitle"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="@dimen/spacing_xl" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suas propostas aparecerão aqui"
            android:textColor="@color/match_text_secondary"
            android:textSize="@dimen/text_caption"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_sm" />
    </LinearLayout>

    <!-- Proposals List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProposals"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp" />

</LinearLayout>
