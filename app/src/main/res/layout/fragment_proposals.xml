<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/match_obsidian"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_xxxl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:background="@drawable/bg_proposals_header"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl">

        <TextView
            android:id="@+id/tvHeaderKicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:text="Castings"
            android:textColor="@color/match_text_secondary"
            android:textSize="@dimen/text_caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.Modela.ScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Propostas" />

            <TextView
                android:id="@+id/tvProposalCount"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_proposal_count_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingHorizontal="@dimen/spacing_md"
                android:textColor="@color/match_white"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Briefings, campanhas e convites selecionados"
            android:textColor="@color/match_text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/proposalFilterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipPending"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/category_chip_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_proposal_filter_chip"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:text="Pendentes"
                android:textColor="@color/match_text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/chipAccepted"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/category_chip_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_proposal_filter_chip"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:text="Aceitas"
                android:textColor="@color/match_text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/chipCompleted"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/category_chip_height"
                android:background="@drawable/bg_proposal_filter_chip"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:text="Concluidas"
                android:textColor="@color/match_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutCreateActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnCreateCampaign"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_proposal_action_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="+ Criar campanha"
            android:textColor="@color/match_white"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCompanyCampaigns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="100dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xxxl"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:alpha="0.3"
            android:contentDescription="Sem propostas"
            android:src="@drawable/ic_proposals"
            app:tint="@color/match_text_secondary" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:fontFamily="sans-serif-medium"
            android:text="Nenhuma proposta ainda"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="Suas propostas aparecerao aqui"
            android:textColor="@color/match_text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProposals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="100dp" />
</LinearLayout>
