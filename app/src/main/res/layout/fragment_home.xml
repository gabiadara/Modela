<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/match_obsidian"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_xxxl">

        <!-- ═══════════════════════════ SHARED HEADER ═══════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHomeGreeting"
                    style="@style/TextAppearance.Modela.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modela" />

                <TextView
                    android:id="@+id/tvHomeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="Encontre o modelo ideal"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="@dimen/avatar_small"
                android:layout_height="@dimen/avatar_small"
                android:src="@drawable/ic_notification"
                android:padding="@dimen/spacing_sm"
                android:contentDescription="Notifications"
                app:tint="@color/match_text_secondary" />
        </LinearLayout>

        <!-- Search Bar (shared) -->
        <FrameLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_bar_height"
            android:layout_marginHorizontal="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:background="@drawable/bg_search_bar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search"
                    app:tint="@color/match_text_hint" />

                <TextView
                    android:id="@+id/tvSearchHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_models"
                    android:textColor="@color/match_text_hint"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginStart="@dimen/spacing_md" />
            </LinearLayout>
        </FrameLayout>

        <!-- Contratante feed -->
        <LinearLayout
            android:id="@+id/layoutCompanyFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_md">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/categories"
                    style="@style/TextAppearance.Modela.Label" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Featured Models -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_md">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/featured"
                    style="@style/TextAppearance.Modela.Label" />

            <TextView
                android:id="@+id/tvSeeAllFeatured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all"
                style="@style/TextAppearance.Modela.Label"
                android:textColor="@color/match_text_hint"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeatured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Trending Models -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_md">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trending"
                    style="@style/TextAppearance.Modela.Label" />

            <TextView
                android:id="@+id/tvSeeAllTrending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all"
                style="@style/TextAppearance.Modela.Label"
                android:textColor="@color/match_text_hint"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Recommended -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recommended"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_md"
                style="@style/TextAppearance.Modela.Label" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecommended"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="70dp"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_lg"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />
        </LinearLayout>

        <!-- Modelo feed -->
        <LinearLayout
            android:id="@+id/layoutModelFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/opportunityFilterContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipOpportunityAll"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_home_filter_chip_active"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="Todas"
                        android:textColor="@color/match_white"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/chipOpportunityUrgent"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_home_filter_chip"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="Urgentes"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/chipOpportunityEditorial"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_home_filter_chip"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="Editorial"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/chipOpportunityCommercial"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_home_filter_chip"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="Comercial"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/chipOpportunityRunway"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_home_filter_chip"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="Passarela"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/chipOpportunityPremium"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_home_filter_chip"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="Premium"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Company spotlight for model users -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@drawable/bg_proposals_header"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Empresas em alta"
                        style="@style/TextAppearance.Modela.Label" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvModelFeedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_opportunity_count_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="78dp"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:text="0 novas"
                    android:textColor="@color/match_white"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCompanySpotlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_xl"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_md">

                <TextView
                    style="@style/TextAppearance.Modela.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Feed de oportunidades" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_model_home_filter_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:text="Recentes"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJobOpenings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="80dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
