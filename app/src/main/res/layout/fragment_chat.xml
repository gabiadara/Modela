<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/match_obsidian"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/spacing_xxxl"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg"
        android:background="@color/match_surface">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/avatar_small"
            android:layout_height="@dimen/avatar_small"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/match_text_primary" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:src="@drawable/bg_placeholder"
            app:civ_border_width="1dp"
            app:civ_border_color="@color/match_gold" />

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/spacing_md" />
    </LinearLayout>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_lg"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_md"
        android:background="@color/match_surface">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="@dimen/chat_input_height"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="@string/type_message"
            android:textColor="@color/match_text_primary"
            android:textColorHint="@color/match_text_hint"
            android:textSize="@dimen/text_caption"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:importantForAutofill="no" />

        <FrameLayout
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_circle_gold">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                android:contentDescription="@string/send"
                app:tint="@color/match_obsidian" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
