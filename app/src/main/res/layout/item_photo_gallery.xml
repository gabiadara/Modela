<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gallery_item_size"
    android:layout_margin="@dimen/spacing_xxs"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/match_surface_variant">
    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_placeholder"
        android:contentDescription="Gallery photo" />
</androidx.cardview.widget.CardView>
