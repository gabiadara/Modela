<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/spacing_xl"
    android:paddingVertical="@dimen/spacing_md">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/avatar_medium"
        android:layout_height="@dimen/avatar_medium"
        android:src="@drawable/ic_avatar_placeholder"
        app:civ_border_width="1dp"
        app:civ_border_color="@color/match_card_border" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_lg">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/match_text_secondary"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/spacing_xxs" />
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/match_text_hint"
            android:layout_marginVertical="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/match_text_hint"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/tvUnreadCount"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_unread_badge"
            android:gravity="center"
            android:textColor="@color/match_white"
            android:textSize="10sp"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_gravity="end"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
