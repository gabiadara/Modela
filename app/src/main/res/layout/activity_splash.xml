<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_splash">

    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M"
            android:textSize="72sp"
            android:textColor="@color/match_gold"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/tvAppName"
            style="@style/TextAppearance.Modela.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/match_cream"
            android:layout_marginTop="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_tagline"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/match_text_secondary"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.15"
            android:layout_marginTop="@dimen/spacing_sm" />
    </LinearLayout>
</FrameLayout>
