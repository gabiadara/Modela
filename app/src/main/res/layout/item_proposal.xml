<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_xl"
    android:layout_marginBottom="@dimen/spacing_lg"
    app:cardBackgroundColor="@color/match_surface_elevated"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_proposal_card_modern"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/avatar_large"
                android:layout_height="@dimen/avatar_large">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProposalPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_placeholder"
                    app:civ_border_color="@color/match_card_border"
                    app:civ_border_width="1dp" />

                <ImageView
                    android:id="@+id/ivProposalCompanyLogo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_company_logo_plate"
                    android:contentDescription="Logo da empresa"
                    android:padding="2dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProposalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_subtitle" />

                <TextView
                    android:id="@+id/tvProposalCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProposalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_xs"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_lg"
            android:background="@color/match_divider" />

        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProposalLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/tvProposalDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProposalBudget"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_proposal_budget_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:textColor="@color/match_text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pendingAnalysisPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Em analise"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="A empresa esta avaliando seu perfil no funil de casting."
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/acceptedJourneyPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_escrow_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Central do Job"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvJourneyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_status_badge"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:text="Confirmado"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAdvanceAcceptedStage"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_proposal_action_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Avancar etapa"
                android:textColor="@color/match_white"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/completedReviewPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCompletedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Job concluido"
                android:textColor="@color/match_text_primary"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/tvCompletedSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Avalie a experiencia"
                android:textColor="@color/match_text_secondary"
                android:textSize="@dimen/text_small" />

            <LinearLayout
                android:id="@+id/ratingPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/star1"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/star2"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/star3"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/star4"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/star5"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRateExperience"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_proposal_action_primary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Avaliar"
                    android:textColor="@color/match_white"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/btnViewReceipt"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_proposal_action_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Resumo"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_button_reject"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Recusar"
                android:textColor="@color/match_error"
                android:textSize="@dimen/text_button" />

            <TextView
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_button_accept"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Aceitar"
                android:textColor="@color/match_white"
                android:textSize="@dimen/text_button" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
