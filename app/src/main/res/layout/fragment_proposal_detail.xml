<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/match_obsidian"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_lg">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back"
                app:tint="@color/match_text_primary"
                android:contentDescription="Voltar" />

            <TextView
                style="@style/TextAppearance.Modela.ScreenTitle.Compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detalhes da Proposta"
                android:gravity="center"
                android:layout_marginEnd="40dp" />
        </LinearLayout>

        <!-- Job Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/match_surface_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivDetailPhoto"
                        android:layout_width="@dimen/avatar_large"
                        android:layout_height="@dimen/avatar_large"
                        android:src="@drawable/bg_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_lg">

                        <TextView
                            android:id="@+id/tvDetailName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/match_text_primary"
                            android:textSize="@dimen/text_title"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvDetailCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/match_text_secondary"
                            android:textSize="@dimen/text_caption"
                            android:layout_marginTop="@dimen/spacing_xxs" />

                        <TextView
                            android:id="@+id/tvDetailStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingVertical="@dimen/spacing_xs"
                            android:textSize="@dimen/text_small"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="@dimen/spacing_sm" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/match_divider"
                    android:layout_marginVertical="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/tvDetailJobTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_subtitle"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvDetailJobDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_lg">

                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/tvDetailBudget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/match_text_primary"
                        android:textSize="@dimen/text_title"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Escrow Timeline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acompanhamento do Casting"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_xl" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/match_surface_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <LinearLayout
                    android:id="@+id/timelineContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTimelineBack"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_proposal_action_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Voltar etapa"
                        android:textColor="@color/match_text_primary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/btnTimelineNext"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_proposal_action_primary"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Proxima etapa"
                        android:textColor="@color/match_white"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Escrow Security Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_escrow_card"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_lg"
            android:padding="@dimen/spacing_lg"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/match_success"
                android:contentDescription="Segurança" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pagamento Protegido"
                    android:textColor="#4F8A6B"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O valor fica retido em garantia (escrow) até a conclusão do trabalho. Você só é cobrado quando o modelo confirmar."
                    android:textColor="@color/match_text_secondary"
                    android:textSize="@dimen/text_small"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>
        </LinearLayout>

        <!-- Location Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local do Trabalho"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_xl" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/match_surface_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Map Placeholder -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_map_placeholder">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_location"
                        app:tint="@color/match_error"
                        android:contentDescription="Localização" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetailLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/match_text_primary"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Endereço confirmado após aceite"
                            android:textColor="@color/match_text_hint"
                            android:textSize="@dimen/text_small"
                            android:layout_marginTop="@dimen/spacing_xxs" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnOpenMap"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_button_outlined"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="Ver Mapa"
                        android:textColor="@color/match_text_primary"
                        android:textSize="@dimen/text_small"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Payment Summary -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumo Financeiro"
            android:textColor="@color/match_text_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_xl" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/match_surface_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cachê do modelo"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_caption" />
                    <TextView
                        android:id="@+id/tvPayCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/match_text_primary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_sm">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Taxa de serviço Modela (10%)"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_caption" />
                    <TextView
                        android:id="@+id/tvPayFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/match_text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/match_divider"
                    android:layout_marginVertical="@dimen/spacing_md" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total em garantia"
                        android:textColor="@color/match_text_primary"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:id="@+id/tvPayTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/match_text_primary"
                        android:textSize="@dimen/text_subtitle"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔒 Valor retido até confirmação de ambas as partes"
                    android:textColor="@color/match_text_hint"
                    android:textSize="@dimen/text_small"
                    android:layout_marginTop="@dimen/spacing_sm" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/detailActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_xl">

            <TextView
                android:id="@+id/btnDetailPrimary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_button_gold"
                android:gravity="center"
                android:text="Aceitar Proposta"
                android:textColor="@color/match_white"
                android:textSize="@dimen/text_button"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btnDetailSecondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_button_outlined"
                android:gravity="center"
                android:text="Enviar Mensagem"
                android:textColor="@color/match_text_primary"
                android:textSize="@dimen/text_button"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/spacing_sm" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
