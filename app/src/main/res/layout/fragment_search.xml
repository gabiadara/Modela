<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/match_obsidian"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_xxxl">

    <TextView
        style="@style/TextAppearance.Modela.ScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_lg" />

    <!-- Search Input and Filter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/search_bar_height"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColor="@color/match_text_primary"
                android:textColorHint="@color/match_text_hint"
                android:textSize="@dimen/text_caption"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/spacing_md"
                android:drawableTint="@color/match_text_hint"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="@dimen/search_bar_height"
            android:layout_height="@dimen/search_bar_height"
            android:layout_marginStart="@dimen/spacing_md"
            android:background="@drawable/bg_search_bar"
            android:src="@drawable/ic_filter_tune"
            app:tint="@color/match_text_primary"
            android:contentDescription="Filtros" />
    </LinearLayout>

    <!-- Category Filters -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- Results Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        android:layout_marginBottom="70dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_search"
            android:contentDescription="No results"
            app:tint="@color/match_text_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_results"
            android:textColor="@color/match_text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/spacing_lg" />
    </LinearLayout>
</LinearLayout>
