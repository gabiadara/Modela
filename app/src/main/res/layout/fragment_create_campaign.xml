<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/match_obsidian">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/ivCampaignCoverPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Capa do job"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_placeholder" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_create_cover_overlay" />

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_marginTop="@dimen/spacing_xxxl"
                    android:background="@drawable/bg_spotlight_category"
                    android:contentDescription="Voltar"
                    android:padding="@dimen/spacing_sm"
                    android:src="@drawable/ic_back"
                    app:tint="@color/match_white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <TextView
                        android:id="@+id/tvCampaignType"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_spotlight_budget"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="@color/match_text_primary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/tvCreateTitle"
                        style="@style/TextAppearance.Modela.ScreenTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Criar job"
                        android:textColor="@color/match_white" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Briefing"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_body" />

                <EditText
                    android:id="@+id/etCampaignTitle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Nome do job"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:singleLine="true"
                    android:text="Editorial Verão 2026"
                    android:textColor="@color/match_text_primary"
                    android:textColorHint="@color/match_text_hint"
                    android:textSize="@dimen/text_caption" />

                <EditText
                    android:id="@+id/etCampaignDescription"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top"
                    android:hint="Descreva estética, perfil desejado, entregáveis e referências"
                    android:inputType="textMultiLine"
                    android:lineSpacingExtra="4dp"
                    android:padding="@dimen/spacing_lg"
                    android:text="Buscamos modelos para um job com estética editorial, luz natural e foco em moda premium."
                    android:textColor="@color/match_text_primary"
                    android:textColorHint="@color/match_text_hint"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCampaignLocation"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Local"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:singleLine="true"
                        android:text="São Paulo, SP"
                        android:textColor="@color/match_text_primary"
                        android:textColorHint="@color/match_text_hint"
                        android:textSize="@dimen/text_caption" />

                    <EditText
                        android:id="@+id/etCampaignBudget"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Verba"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:singleLine="true"
                        android:text="R$ 3.500"
                        android:textColor="@color/match_text_primary"
                        android:textColorHint="@color/match_text_hint"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tags da oportunidade"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNewTag"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Criar tag"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:singleLine="true"
                        android:textColor="@color/match_text_primary"
                        android:textColorHint="@color/match_text_hint"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/btnAddTag"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_proposal_action_primary"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/match_white"
                        android:textSize="@dimen/text_title" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/createTagContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvEmptyTags"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="Nenhuma tag adicionada"
                            android:textColor="@color/match_text_hint"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnChooseCover"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:background="@drawable/bg_proposal_action_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Adicionar capa"
                    android:textColor="@color/match_text_primary"
                    android:textSize="@dimen/text_button" />

                <TextView
                    android:id="@+id/btnCreateCampaign"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_proposal_action_primary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Criar job"
                    android:textColor="@color/match_white"
                    android:textSize="@dimen/text_button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#DDF1F1F1"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/successCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xxxl"
            android:scaleX="0.84"
            android:scaleY="0.84">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_success_circle">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:contentDescription="Criado"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/match_white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:fontFamily="sans-serif-medium"
                android:id="@+id/tvSuccessTitle"
                android:text="Job criado"
                android:textColor="@color/match_text_primary"
                android:textSize="@dimen/text_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="Seu briefing esta pronto para receber perfis"
                android:textColor="@color/match_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
