<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget Styles -->
    <style name="Widget.Modela.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/match_obsidian</item>
        <item name="itemIconTint">@color/selector_bottom_nav_color</item>
        <item name="itemTextColor">@color/selector_bottom_nav_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemRippleColor">@color/match_ripple</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.Modela.Button.Gold" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_gold</item>
        <item name="android:textColor">@color/match_obsidian</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.Modela.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textColor">@color/match_gold</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.Modela.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/match_text_primary</item>
        <item name="android:fontFamily">@font/montserrat_variablefont_wght</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Modela.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/match_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Modela.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/match_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Modela.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/match_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.Modela.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/match_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Modela.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/match_text_secondary</item>
        <item name="android:fontFamily">@font/montserrat_variablefont_wght</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- EditText Style -->
    <style name="Widget.Modela.EditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/match_surface_variant</item>
        <item name="boxStrokeColor">@color/match_card_border</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/match_text_hint</item>
        <item name="android:textColorHint">@color/match_text_hint</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.Modela.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/match_surface_elevated</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.Modela.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/match_text_primary</item>
    </style>
</resources>
